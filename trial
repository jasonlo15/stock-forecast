import argparse
import json
from pathlib import Path
import numpy as np
import pandas as pd


def load_prices(path):
    df = pd.read_csv(path)
    df.columns = df.columns.str.strip().str.lower()
    if not {'date', 'close'} <= set(df.columns):
        raise ValueError('CSV needs date,close columns')
    df['date'] = pd.to_datetime(df['date'], errors='raise')
    df = df.sort_values('date').reset_index(drop=True)
    if df['date'].duplicated().any():
        raise ValueError('Duplicate dates are not allowed')
    df['close'] = pd.to_numeric(df['close'], errors='raise')
    if not np.isfinite(df['close']).all() or (df['close'] <= 0).any():
        raise ValueError('Close must be finite and positive')
    return df


def features(close):
    ret = close.pct_change()
    x = pd.DataFrame(index=close.index)
    for n in (1, 5, 20):
        x[f'return_{n}'] = close.pct_change(n)
    for n in (5, 20, 60):
        x[f'ma_gap_{n}'] = close / close.rolling(n).mean() - 1
    x['volatility_20'] = ret.rolling(20).std()
    return x


def predict(x, y, query):
    mean, scale = x.mean(axis=0), x.std(axis=0)
    scale = np.where(scale < 1e-12, 1., scale)
    z = (x - mean) / scale
    target_mean = y.mean()
    beta = np.linalg.solve(z.T @ z + 10 * np.eye(z.shape[1]), z.T @ (y - target_mean))
    return float(target_mean + ((query - mean) / scale) @ beta)


def run(df, horizon=5, min_train=252, backtest=126):
    if horizon not in (1, 5, 20):
        raise ValueError('Horizon must be 1, 5 or 20 trading observations')
    if min_train < 30 or backtest < 1:
        raise ValueError('min_train >= 30 and backtest >= 1 required')
    close = df['close']
    x = features(close)
    y = close.shift(-horizon) / close - 1
    valid = x.notna().all(axis=1)
    labeled = valid & y.notna()
    if labeled.sum() < min_train + 30:
        raise ValueError('Need more history: at least min_train + 30 labeled samples + 60 + horizon rows')
    rows = []
    # Only labels whose endpoint is known at the forecast origin can train the model.
    for t in range(max(60, len(df) - horizon - backtest), len(df) - horizon):
        train = labeled & (np.arange(len(df)) + horizon <= t)
        if train.sum() < min_train:
            continue
        p = predict(x.loc[train].to_numpy(), y.loc[train].to_numpy(), x.iloc[t].to_numpy())
        rows.append({'date': str(df.date.iloc[t].date()), 'predicted_return': p,
                     'actual_return': float(y.iloc[t]), 'training_samples': int(train.sum())})
    bt = pd.DataFrame(rows)
    if len(bt) < 30:
        raise ValueError('Need at least 30 backtest observations; increase history/backtest')
    last = len(df) - 1
    train = labeled & (np.arange(len(df)) + horizon <= last)
    p = predict(x.loc[train].to_numpy(), y.loc[train].to_numpy(), x.iloc[last].to_numpy())
    mae = float((bt.predicted_return - bt.actual_return).abs().mean())
    baseline = float(bt.actual_return.abs().mean())
    report = {
        'as_of': str(df.date.iloc[-1].date()), 'horizon_trading_observations': horizon,
        'last_close': float(close.iloc[-1]), 'predicted_return': p,
        'estimated_price_same_basis_as_input': float(close.iloc[-1] * (1 + p)),
        'backtest_samples': len(bt), 'return_mae': mae, 'zero_return_baseline_mae': baseline,
        'direction_accuracy': float((np.sign(bt.predicted_return) == np.sign(bt.actual_return)).mean()),
        'beats_zero_return_baseline_mae': bool(mae < baseline),
        'note': 'Research estimate; no calibrated probability or guaranteed accuracy. Overlapping horizons are correlated.'
    }
    return report, bt


if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('csv')
    parser.add_argument('--horizon', type=int, default=5, choices=[1, 5, 20])
    parser.add_argument('--output', default='output')
    args = parser.parse_args()
    try:
        result, bt = run(load_prices(args.csv), args.horizon)
    except (ValueError, OSError) as exc:
        parser.exit(2, f'Error: {exc}\n')
    out = Path(args.output)
    out.mkdir(parents=True, exist_ok=True)
    (out / 'forecast.json').write_text(json.dumps(result, indent=2, ensure_ascii=False), encoding='utf-8')
    bt.to_csv(out / 'backtest.csv', index=False)
    print(json.dumps(result, indent=2, ensure_ascii=False))
